# Base URL for the backend API this app talks to.
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com

# Deployment environment: dev | staging | production
NEXT_PUBLIC_ENV=dev

# Which app preset boots: no_auth (default) | backend_auth_sample
NEXT_PUBLIC_APP_PRESET=no_auth

# Which auth adapter is active: none (default) | reference_backend | custom_backend
NEXT_PUBLIC_AUTH_PROVIDER=none

# Client + server log verbosity: debug | info | warn | error
NEXT_PUBLIC_LOG_LEVEL=info

# Server-only. Optional remote log sink endpoint. Never prefixed with
# NEXT_PUBLIC_ — must never reach the client bundle.
REMOTE_LOG_URL=

# Server-only. Bearer token for the remote log sink, if configured.
REMOTE_LOG_BEARER_TOKEN=

# Header name used to propagate a per-request correlation id.
NEXT_PUBLIC_REQUEST_ID_HEADER=X-Request-Id

# Optional WebSocket endpoint. Plumbing only until a project's real-time
# feature consumes it.
NEXT_PUBLIC_WS_URL=
